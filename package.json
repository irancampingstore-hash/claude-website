{
  "name": "iran-camping-mcp-hub",
  "version": "0.1.0",
  "description": "Unified MCP hub for Iran Camping: irancamping.com, iranoutdoor.com VPS, local PC + local AI, Instagram, and Iran Camping / Barney AI agents.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "start:stdio": "node dist/server.js --stdio",
    "agent": "node dist/pc-agent/main.js",
    "dev": "tsx watch src/server.ts",
    "dev:agent": "tsx src/pc-agent/main.ts",
    "test": "vitest run",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "ssh2": "^1.17.0",
    "undici": "^7.30.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
