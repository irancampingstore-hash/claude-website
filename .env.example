# ───────────────────────── Iran Camping MCP Hub — environment ─────────────────────────
# Copy to .env (never commit it). Generate secrets with:  node dist/cli.js secret

# ── Core ──
PORT=8787
# Public HTTPS address of the hub (what Claude / ChatGPT / Gemini connect to).
HUB_PUBLIC_URL=https://mcp.iranoutdoor.com
# 32+ random chars. Encrypts stored Instagram tokens and signs confirmation tokens. Changing it invalidates both.
HUB_SECRET=
HUB_DATA_DIR=./data
# Set to 1 when running behind nginx (so rate limits see the real client IP)
HUB_TRUST_PROXY=1
# Two-step confirmation for risky actions: token (default, recommended) | off
HUB_CONFIRM_MODE=token
HUB_RATE_LIMIT_PER_MINUTE=120

# ── irancamping.com (WordPress + WooCommerce) ──
WP_URL=https://irancamping.com
# WordPress → Users → Profile → Application Passwords (create a dedicated user such as "mcp-hub" with Editor or Shop Manager role)
WP_USER=
WP_APP_PASSWORD=
# WooCommerce → Settings → Advanced → REST API → Add key (Read/Write)
WC_KEY=
WC_SECRET=

# ── New VPS on Mihan Web: iranoutdoor.com ──
# ssh = hub runs elsewhere and connects over SSH; local = hub runs ON the VPS itself
VPS_MODE=ssh
VPS_HOST=
VPS_PORT=22
# Use a dedicated non-root user for the hub (see docs/SECURITY.md)
VPS_USER=mcphub
VPS_PRIVATE_KEY_PATH=./data/vps_key
# VPS_KEY_PASSPHRASE=
# Get it with:  ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub -E sha256   (paste the part after SHA256:)
VPS_HOST_KEY_SHA256=
VPS_SITE_URL=https://iranoutdoor.com
VPS_SERVICES=nginx,mysql,php8.2-fpm
VPS_LOG_PATHS=/var/log/nginx/error.log,/var/log/nginx/access.log,/var/log/syslog
VPS_FILE_ROOTS=/var/www,/etc/nginx

# ── Your computer (PC agent) ──
# Same value on the hub and on the PC. Generate with: node dist/cli.js secret
PC_AGENT_TOKEN=

# ── Instagram (Instagram API with Instagram Login — no Facebook login) ──
# Create an app at developers.facebook.com → "Instagram" use case → API setup with Instagram login
IG_APP_ID=
IG_APP_SECRET=
IG_API_VERSION=v23.0
# Meta APIs are often unreachable from Iranian servers. Route Instagram calls through a proxy that can reach them:
# IG_PROXY_URL=http://user:pass@proxy-host:3128
# Any random string; put the same value in the Meta app's webhook settings
IG_WEBHOOK_VERIFY_TOKEN=

# ── AI agents (Iran Camping agent, Barney) ──
AGENTS_CONFIG=./agents.json
# Credentials referenced from agents.json via "authEnv":
# IRANCAMPING_AGENT_TOKEN=
# BARNEY_AGENT_TOKEN=
# Tokens the agents use to push events to the hub (/api/agents/events) — one per agent:
# AGENT_BUS_TOKEN_IRANCAMPING=
# AGENT_BUS_TOKEN_BARNEY=
